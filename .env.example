# Firebase web app config (Firebase console → Project settings → Your apps → Web app → SDK setup and configuration)
# These values are not secret: Firestore security rules (firestore.rules) protect your data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Hidden admin key: type this anywhere on the site (outside a text field),
# or open https://your-site/#<key>, to open the admin panel login.
VITE_ADMIN_KEY=
